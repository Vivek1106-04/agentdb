# Copy to .env (gitignored) and fill in. Nothing here is read at import time;
# only a live run — `make bench`, the e2e tests, scripts/verify_databricks.py —
# reaches for these.

# --- models -----------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- ClickHouse (local, from docker/docker-compose.yml) ----------------------
# Defaults match `make up`, so these only need setting on a different host.
AGENTEVAL_CLICKHOUSE_HOST=localhost
AGENTEVAL_CLICKHOUSE_PORT=58123
AGENTEVAL_CLICKHOUSE_USER=agentdb_ro
AGENTEVAL_CLICKHOUSE_DATABASE=agentdb

# --- Databricks (a SQL warehouse; Free Edition is enough) -------------------
# Free Edition ships samples.tpch pre-loaded, so the Databricks half of tpch_nl
# needs no data loading, no Docker and no cluster configuration (SPEC 1.2).
#
#   HOST         the workspace URL, e.g. https://dbc-1234abcd-5678.cloud.databricks.com
#   WAREHOUSE_ID the SQL warehouse id: SQL Warehouses -> your warehouse ->
#                Connection details, or the last path segment of its URL
#   TOKEN        a personal access token: Settings -> Developer -> Access tokens
#                (or use CLIENT_ID/CLIENT_SECRET for an OAuth service principal)
#
# The principal needs SELECT only. Nothing in the measurement path writes:
# ANALYZE is never issued, and shadow validation is opt-in and separately
# configured (AGENTDB_DBX_SCRATCH_SCHEMA, which has no default on purpose).
AGENTEVAL_DBX_HOST=
AGENTEVAL_DBX_WAREHOUSE_ID=
AGENTEVAL_DBX_TOKEN=
# AGENTEVAL_DBX_CLIENT_ID=
# AGENTEVAL_DBX_CLIENT_SECRET=
AGENTEVAL_DBX_CATALOG=samples
AGENTEVAL_DBX_SCHEMA=tpch

# The server-side adapter reads the same workspace under its own prefix.
# scripts/verify_databricks.py mirrors AGENTEVAL_DBX_* onto these, so setting
# them twice is optional.
# AGENTDB_DBX_HOST=
# AGENTDB_DBX_WAREHOUSE_ID=
# AGENTDB_DBX_TOKEN=
